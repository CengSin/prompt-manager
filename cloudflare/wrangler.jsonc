{
  "name": "prompt-manager",
  "main": "src/worker.mjs",
  "account_id": "0b6decfbed0f3439726d7ded971b57e5",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "prompt-manager",
      "database_id": "58504f51-4bf5-42c6-9f93-881c0ba808e3"
    }
  ],
  "workflows": [
    {
      "binding": "DERIVE_WORKFLOW",
      "name": "prompt-manager-derive",
      "class_name": "PromptDerivation"
    }
  ],
  "routes": [
    {
      "pattern": "prompts.cengsin.ccwu.cc",
      "custom_domain": true,
      "zone_id": "92e2b08acc2ae581d05a730dce5bcb84"
    }
  ]
}
